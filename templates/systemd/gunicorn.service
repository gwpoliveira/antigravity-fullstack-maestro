[Unit]
Description=Gunicorn Application Server for Django Backend (Bare-Metal)
Requires=gunicorn.socket
After=network.target mysql.service

[Service]
Type=notify
User=ubuntu
Group=www-data
RuntimeDirectory=gunicorn
WorkingDirectory=/var/www/meu-app/backend

# Carregar variáveis de ambiente diretamente do .env seguro
EnvironmentFile=/var/www/meu-app/backend/.env

# Executável do Gunicorn no venv isolado
ExecStart=/var/www/meu-app/backend/venv/bin/gunicorn \
          --workers 3 \
          --threads 2 \
          --worker-class gthread \
          --worker-tmp-dir /dev/shm \
          --bind unix:/run/gunicorn.sock \
          --access-logfile /var/log/gunicorn/access.log \
          --error-logfile /var/log/gunicorn/error.log \
          --capture-output \
          --enable-stdio-inheritance \
          core.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
